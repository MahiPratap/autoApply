# Copy to .env and fill in. .env is gitignored.

# --- AI ---------------------------------------------------------------------
# The only recurring cost in this system. Swapping Claude accounts later is an
# edit to this line plus a restart; nothing else changes.
ANTHROPIC_API_KEY=sk-ant-...

# --- Database ---------------------------------------------------------------
# SQLite. Relative paths are resolved from the project root and converted to
# absolute, so the Prisma CLI and the app always open the same file.
DATABASE_URL="file:./storage/autoapply.db"

# --- Behaviour --------------------------------------------------------------
# dry-run : discover, score, prepare — never submit          (start here)
# review  : queue matches for manual approval before submit  (safe default)
# auto    : submit automatically above the score threshold
MODE=dry-run

# trace | debug | info | warn | error
LOG_LEVEL=info

# Used for quiet-hours and "posted in the last 24h" calculations.
TZ=Asia/Kolkata
